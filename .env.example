# TheButler Configuration

# OpenAI API Key for AI Matching, Resume Tailoring & Question Generation
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (SQLite default for simple local setup, PostgreSQL supported)
DATABASE_URL=sqlite:///./thebutler.db
# Example PostgreSQL URL: postgresql://user:password@localhost:5432/thebutler_db

# User Details & Settings Default
DEFAULT_USER_EMAIL=hameem@example.com
DEFAULT_USER_NAME=Hameem

# Application Mode: MANUAL, APPROVAL_REQUIRED, AUTOMATIC
APPLICATION_MODE=APPROVAL_REQUIRED

# Daily Application Limit
DAILY_APPLICATION_LIMIT=10

# Minimum Match Score Threshold (0-100)
MIN_MATCH_SCORE=75

# Playwright Browser Headless Mode (true/false)
PLAYWRIGHT_HEADLESS=false

# Notification Webhook (Optional Discord/Slack webhook URL)
NOTIFICATION_WEBHOOK_URL=
